# Copiá a `.env` y completá los valores.
# cp .env.example .env

# OpenAI / Gemini (analyzeReply)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Terraform / sync local
# TF_VAR_openai_api_key=
# TF_VAR_socialcrawl_api_key=
# TF_STATE_BUCKET=responselens-tfstate-ACCOUNT
# TF_STATE_KEY=dev/terraform.tfstate
# AWS_REGION=eu-central-1

# SPA local — generado por `npm run sync:env` (o pegá manual en .env.local)
# APPSYNC_GRAPHQL_URL=https://xxxx.appsync-api.eu-central-1.amazonaws.com/graphql
# APPSYNC_REALTIME_URL=wss://xxxx.appsync-realtime-api.eu-central-1.amazonaws.com/graphql
# APPSYNC_API_KEY=da2-xxxxxxxx
# SOCIALCRAWL_API_KEY=sc_xxxxxxxx   # patch-socialcrawl-env.sh (gitignored en .env.local)
# COGNITO_USER_POOL_ID=eu-central-1_xxxxx
# COGNITO_CLIENT_ID=xxxxxxxx
